"<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> حذف کاربر ناموفق بود:\n"
"<code>{error}</code>"

msgid "BTN_ADMIN_BROADCAST_MODE_COPY"
msgstr "ارسال همان‌طور که هست"

msgid "BTN_ADMIN_BROADCAST_MODE_COMPOSE"
msgstr "ساخت پیام"

msgid "ADMIN_BROADCAST_SELECT_MODE"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> می‌خواهید ارسال همگانی را چگونه آماده کنید؟\n"
"\n"
"<b>ارسال همان‌طور که هست</b> — پیام آماده را کامل ارسال کنید (متن، رسانه، قالب‌بندی، دکمه‌ها — در صورت وجود)، بدون تغییر برای هر گیرنده کپی می‌شود.\n"
"\n"
"<b>ساخت پیام</b> — متن یا رسانه ارسال کنید و سپس دکمه‌ها (با لینک یا عملکرد) را جداگانه اضافه کنید."

msgid "ADMIN_BROADCAST_PROMPT"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> پیامی را که می‌خواهید برای کاربران ارسال کنید بفرستید — همان‌طور که هست، همراه با هر رسانه و کیبورد پیوست‌شده برای گیرندگان کپی می‌شود.\n"
"\n"
"قالب‌بندی HTML تلگرام پشتیبانی می‌شود."

msgid "ADMIN_BROADCAST_CONTENT_PROMPT"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> متن یا رسانه (با کپشن یا بدون آن) را برای ارسال همگانی بفرستید. در مرحله بعد می‌توانید دکمه‌ها را به آن اضافه کنید.\n"
"\n"
"قالب‌بندی HTML تلگرام پشتیبانی می‌شود."

msgid "ADMIN_BROADCAST_KEYBOARD_BUILDER"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> <b>افزودن کیبورد</b>\n"
"\n"
"قالب دکمه:\n"
"<code>متن - callback_data</code>\n"
"\n"
"چند دکمه در یک ردیف:\n"
"<code>کاتالوگ - catalog | راهنما - help</code>\n"
"\n"
"لینک:\n"
"<code>وب‌سایت - https://example.com</code>\n"
"\n"
"پارامترهای اضافی:\n"
"<code>دکمه - action [style=primary]</code>\n"
"<code>دکمه - action [emoji=123456]</code>\n"
"\n"
"سبک‌ها: <code>success</code>، <code>primary</code>، <code>danger</code>.\n"
"\n"
"برای ردیف جدید، از خط جدید شروع کنید.\n"
"\n"
"اگر کیبورد لازم نیست، «رد کردن» را بزنید."

msgid "ADMIN_BROADCAST_NO_CONTENT"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> دریافت محتوای ارسال همگانی ناموفق بود. از ابتدا شروع کنید."

msgid "ADMIN_BROADCAST_PREVIEW"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> ارسال همگانی این‌گونه نمایش داده می‌شود. تعداد گیرندگان: <b>{count}</b>.\n"
"\n"
"ارسال تأیید شود؟"

msgid "ADMIN_BROADCAST_CANCELLED"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> ارسال همگانی لغو شد."

msgid "ADMIN_BROADCAST_STARTED"
msgstr "<tg-emoji emoji-id=\"5891211339170326418\">⏳</tg-emoji> ارسال همگانی آغاز شد. تعداد گیرندگان: <b>{count}</b>."

msgid "ADMIN_BROADCAST_PROGRESS"
msgstr "<tg-emoji emoji-id=\"5891211339170326418\">⏳</tg-emoji> ارسال همگانی در حال انجام: {sent}/{total}"

msgid "ADMIN_BROADCAST_DONE"
msgstr ""
"<tg-emoji emoji-id=\"6030445631921721471\">✅</tg-emoji> ارسال همگانی تکمیل شد.\n"
"<blockquote>مجموع گیرندگان: {total}\n"
"تحویل موفق: {success}\n"
"تحویل ناموفق: {failed}</blockquote>"

msgid "BTN_ADMIN_BROADCAST_CONFIRM"
msgstr "ارسال"

msgid "BTN_ADMIN_BROADCAST_CANCEL"
msgstr "لغو"

msgid "BTN_ADMIN_BROADCAST_NO_KEYBOARD"
msgstr "بدون دکمه"

msgid "BTN_ADMIN_PROVIDER_CREATE"
msgstr "ایجاد ارائه‌دهنده"

msgid "BTN_ADMIN_PROVIDER_RENAME"
msgstr "تغییر نام"

msgid "BTN_ADMIN_PROVIDER_SET_URL"
msgstr "تغییر URL"

msgid "BTN_ADMIN_PROVIDER_DELETE"
msgstr "حذف"

msgid "BTN_ADMIN_PROVIDER_SKIP"
msgstr "رد کردن"

msgid "BTN_ADMIN_PROVIDER_CLEAR"
msgstr "پاک کردن"

msgid "ADMIN_PROVIDERS_LIST_TITLE"
msgstr ""
"<tg-emoji emoji-id=\"5931347928810526429\">🏷</tg-emoji> <b>ارائه‌دهندگان</b>\n"
"\n"
"مجموع: <b>{count}</b>.\n"
"یک ارائه‌دهنده انتخاب کنید یا ارائه‌دهنده جدید بسازید:"

msgid "ADMIN_PROVIDERS_LIST_EMPTY"
msgstr ""
"<tg-emoji emoji-id=\"5931347928810526429\">🏷</tg-emoji> <b>ارائه‌دهندگان</b>\n"
"\n"
"هنوز ارائه‌دهنده‌ای وجود ندارد."

msgid "ADMIN_PROVIDER_DETAILS"
msgstr ""
"<tg-emoji emoji-id=\"5931347928810526429\">🏷</tg-emoji> ارائه‌دهنده <b>{provider_name}</b>\n"
"Hash: <code>{provider_hash}</code>\n"
"Owner hash: <code>{owner_hash}</code>\n"
"URL: {provider_url}\n"
"توکن: <blockquote><tg-spoiler>{api_token}</tg-spoiler></blockquote>"

msgid "ADMIN_PROVIDER_NOT_FOUND"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> ارائه‌دهنده یافت نشد."

msgid "ADMIN_PROVIDER_CREATE_PROMPT_OWNER"
msgstr ""
"<tg-emoji emoji-id=\"5886412370347036129\">👤</tg-emoji> شناسه تلگرام کاربری را که مالک ارائه‌دهنده جدید خواهد بود ارسال کنید.\n"
"\n"
"کاربر باید از قبل حساب v2hub داشته باشد — در صورت نیاز ساخته می‌شود."

msgid "ADMIN_PROVIDER_CREATE_PROMPT_NAME"
msgstr "<tg-emoji emoji-id=\"5931347928810526429\">🏷</tg-emoji> نام ارائه‌دهنده جدید را ارسال کنید (باید منحصربه‌فرد باشد)."

msgid "ADMIN_PROVIDER_CREATE_PROMPT_URL"
msgstr "<tg-emoji emoji-id=\"5931347928810526429\">🏷</tg-emoji> URL ارائه‌دهنده را ارسال کنید یا «رد کردن» را بزنید."

msgid "ADMIN_PROVIDER_CREATE_NAME_INVALID"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> نام نمی‌تواند خالی باشد. دوباره تلاش کنید."

msgid "ADMIN_PROVIDER_CREATE_ERROR"
msgstr ""
"<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> ایجاد ارائه‌دهنده ناموفق بود:\n"
"<code>{error}</code>"

msgid "ADMIN_PROVIDER_CREATE_CONFLICT"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> ارائه‌دهنده‌ای با نام <b>{provider_name}</b> از قبل وجود دارد."

msgid "ADMIN_PROVIDER_CREATED"
msgstr ""
"<tg-emoji emoji-id=\"6030445631921721471\">✅</tg-emoji> ارائه‌دهنده <b>{provider_name}</b> ایجاد شد.\n"
"<blockquote>Owner: <code>{owner_id}</code>\n"
"توکن: <code>{api_token}</code></blockquote>"

msgid "ADMIN_PROVIDER_RENAME_PROMPT"
msgstr "<tg-emoji emoji-id=\"5931347928810526429\">🏷</tg-emoji> نام جدید ارائه‌دهنده <b>{provider_name}</b> را ارسال کنید."

msgid "ADMIN_PROVIDER_RENAMED"
msgstr "<tg-emoji emoji-id=\"6030445631921721471\">✅</tg-emoji> نام ارائه‌دهنده به <b>{provider_name}</b> تغییر کرد."

msgid "ADMIN_PROVIDER_RENAME_CONFLICT"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> نام <b>{provider_name}</b> قبلاً گرفته شده است. نام دیگری امتحان کنید."

msgid "ADMIN_PROVIDER_SET_URL_PROMPT"
msgstr "<tg-emoji emoji-id=\"5931347928810526429\">🏷</tg-emoji> URL جدید ارائه‌دهنده <b>{provider_name}</b> را ارسال کنید یا برای حذف URL «پاک کردن» را بزنید."

msgid "ADMIN_PROVIDER_URL_UPDATED"
msgstr "<tg-emoji emoji-id=\"6030445631921721471\">✅</tg-emoji> URL ارائه‌دهنده به‌روزرسانی شد."

msgid "ADMIN_PROVIDER_UPDATE_ERROR"
msgstr ""
"<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> به‌روزرسانی ارائه‌دهنده ناموفق بود:\n"
"<code>{error}</code>"

msgid "ADMIN_PROVIDER_DELETE_CONFIRM"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">⚠️</tg-emoji> ارائه‌دهنده <b>{provider_name}</b> حذف شود؟ این عمل بازگشت‌ناپذیر است."

msgid "ADMIN_PROVIDER_DELETED"
msgstr "<tg-emoji emoji-id=\"6030445631921721471\">✅</tg-emoji> ارائه‌دهنده <b>{provider_name}</b> حذف شد."

msgid "ADMIN_PROVIDER_DELETE_ERROR"
msgstr ""
"<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> حذف ارائه‌دهنده ناموفق بود:\n"
"<code>{error}</code>"
