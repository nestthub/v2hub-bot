msgid "WELCOME_NEW"
msgstr ""
"<tg-emoji emoji-id=\"5906995262378741881\">👋</tg-emoji> Hello, <b>{name}</b>!\n"
"\n"
"<b>v2hub</b> is your personal VPN manager.\n"
"\n"
"Connect a device once via a subscription link and forget about manual setup for good. All changes are applied automatically on each of your devices: phone, laptop, tablet, and your family members' devices."

msgid "WELCOME_RETURNING"
msgstr ""
"<tg-emoji emoji-id=\"5906995262378741881\">👋</tg-emoji> Welcome back, <b>{name}</b>!\n"
"\n"
"Everything is under control — manage your connections through the panel."

msgid "TOKEN_NONE"
msgstr ""
"<tg-emoji emoji-id=\"6005570495603282482\">🔑</tg-emoji> <b>Access token</b>\n"
"\n"
"You don't have a token yet — you won't be able to log in to the panel without it.\n"
"Tap the button below to get one right now."

msgid "TOKEN_INFO"
msgstr ""
"<tg-emoji emoji-id=\"6005570495603282482\">🔑</tg-emoji> <b>Your access token</b>\n"
"\n"
"<blockquote><code>{token}</code></blockquote>\n"
"\n"
"<tg-emoji emoji-id=\"5881702736843511327\">⚠️</tg-emoji> Never share your token with anyone: it gives full access to your account."

msgid "TOKEN_GENERATING"
msgstr "⏳ Creating token…"

msgid "TOKEN_CREATED"
msgstr ""
"<tg-emoji emoji-id=\"6030445631921721471\">✅</tg-emoji> <b>Token is ready!</b>\n"
"\n"
"<blockquote><code>{token}</code></blockquote>\n"
"\n"
"Copy it and paste it when logging in to the control panel.\n"
"\n"
"<tg-emoji emoji-id=\"5881702736843511327\">⚠️</tg-emoji> Never share your token with anyone: it gives full access to your account."

msgid "TOKEN_REFRESHING"
msgstr "⏳ Refreshing token…"

msgid "TOKEN_REFRESHED"
msgstr ""
"<tg-emoji emoji-id=\"6005843436479975944\">🔄</tg-emoji> <b>Token refreshed!</b>\n"
"\n"
"<blockquote><code>{token}</code></blockquote>\n"
"\n"
"The old token has been deactivated — paste the new one in the control panel.\n"
"\n"
"<tg-emoji emoji-id=\"5881702736843511327\">⚠️</tg-emoji> Never share your token with anyone: it gives full access to your account."

msgid "TOKEN_NO_ACTIVE"
msgstr "You don't have an active token."

msgid "TOKEN_ERROR_GENERATE"
msgstr ""
"<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> Failed to create token:\n"
"<code>{error}</code>\n"
"\n"
"Please try again later or contact support."

msgid "TOKEN_ERROR_REFRESH"
msgstr ""
"<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> Failed to refresh token:\n"
"<code>{error}</code>\n"
"\n"
"Please try again later or contact support."

msgid "HELP_TEXT"
msgstr ""
"<tg-emoji emoji-id=\"6030848053177486888\">❓</tg-emoji> <b>Help</b>\n"
"\n"
"<b>v2hub</b> is a VPN connection management service. Set up your device once, and all updates will be applied automatically.\n"
"\n"
"<b>Commands:</b>\n"
"<blockquote>/start — main menu\n"
"/token — access token\n"
"/settings - bot settings\n"
"/support — contact support</blockquote>\n"
"\n"
"<b>Getting started:</b>\n"
"1. Get a token via /token\n"
"2. Open the panel and paste the token when logging in\n"
"3. Add your devices — changes will be applied automatically\n"
"\n"
"When you refresh your token, the old one is deactivated. Don't forget to paste the new one in the panel."

msgid "SUPPORT_TEXT"
msgstr ""
"<tg-emoji emoji-id=\"5936017305585586269\">📩</tg-emoji> <b>Support</b>\n"
"\n"
"Something went wrong or have a question?\n"
"We're here — write to us and we'll sort it out.\n"
"\n"
"The more detail you give, the faster we can help."

msgid "PROVIDER_INTRO"
msgstr ""
"<tg-emoji emoji-id=\"6005570495603282482\">🏷</tg-emoji> <b>Provider</b>\n"
"\n"
"A provider is a v2hub partner with its own VPN service who can onboard users and manage their subscriptions via the API.\n"
"\n"
"<b>To become a provider, you need:</b>\n"
"<blockquote>• an operating VPN service;\n"
"• or a clearly confirmed intention to build a service on top of v2hub</blockquote>\n"
"\n"
"The provider role is granted by an administrator only. Contact support to get your own provider."

msgid "PROVIDER_INFO"
msgstr ""
"<tg-emoji emoji-id=\"6005570495603282482\">🏷</tg-emoji> <b>Your provider</b>\n"
"\n"
"<b>Name:</b> {provider_name}\n"
"<b>URL:</b> {provider_url}"

msgid "PROVIDER_TOKEN_INFO"
msgstr ""
"<tg-emoji emoji-id=\"6005570495603282482\">🔑</tg-emoji> <b>Provider token</b>\n"
"\n"
"<blockquote><code>{token}</code></blockquote>\n"
"\n"
"<tg-emoji emoji-id=\"5881702736843511327\">⚠️</tg-emoji> Never share this token with anyone: it gives full access to your provider's API."

msgid "PROVIDER_TOKEN_REFRESHING"
msgstr "⏳ Refreshing provider token…"

msgid "PROVIDER_TOKEN_REFRESHED"
msgstr ""
"<tg-emoji emoji-id=\"6005843436479975944\">🔄</tg-emoji> <b>Provider token refreshed!</b>\n"
