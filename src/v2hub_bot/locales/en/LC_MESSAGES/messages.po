msgid "PROVIDER_NOT_FOUND_FOR_ROLE"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> Your provider account was not found. Please contact support."

msgid "PROVIDER_PUBLIC_INFO"
