msgid "PROVIDER_CONNECTION_REQUEST"
msgstr ""
"<tg-emoji emoji-id=\"6005570495603282482\">🏷</tg-emoji> <b>Provider connection request</b>\n"
"\n"
"<b>{provider_name}</b>\n"
"URL: {provider_url}\n"
"\n"
"The provider is requesting access to add subscriptions.\n"
"\n"
"<tg-emoji emoji-id=\"6030445631921721471\">✅</tg-emoji> Connecting a provider <b>does not affect</b> your personal subscriptions — new ones are created alongside them.\n"
"\n"
"<tg-emoji emoji-id=\"5881702736843511327\">🔒</tg-emoji> Approve or decline the request below."

msgid "PROVIDER_CONNECTION_LINK_INVALID"
msgstr ""
