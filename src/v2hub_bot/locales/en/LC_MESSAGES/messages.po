msgid "BTN_ADMIN_BROADCAST_MODE_COPY"
msgstr "Forward as is"

msgid "BTN_ADMIN_BROADCAST_MODE_COMPOSE"
msgstr "Compose message"

msgid "ADMIN_BROADCAST_SELECT_MODE"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> How would you like to prepare the broadcast?\n"
"\n"
"<b>Forward as is</b> — send a finished message in full (text, media, formatting, buttons — if any), and it will be copied to each recipient unchanged.\n"
"\n"
"<b>Compose message</b> — send text or media, then add buttons (with a link or an action) separately."

msgid "ADMIN_BROADCAST_PROMPT"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> Send the message you want to broadcast to users — it will be copied to recipients as is, along with any media and an already attached keyboard.\n"
"\n"
"Telegram HTML markup is supported."

msgid "ADMIN_BROADCAST_CONTENT_PROMPT"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> Send text or media (with or without a caption) for the broadcast. In the next step you will be able to add buttons to it.\n"
"\n"
"Telegram HTML markup is supported."

msgid "ADMIN_BROADCAST_KEYBOARD_BUILDER"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> <b>Adding a keyboard</b>\n"
"\n"
"Button format:\n"
"<code>Text - callback_data</code>\n"
"\n"
"Several buttons in a row:\n"
"<code>Catalog - catalog | Help - help</code>\n"
"\n"
"Link:\n"
"<code>Website - https://example.com</code>\n"
"\n"
"Additional parameters:\n"
"<code>Button - action [style=primary]</code>\n"
"<code>Button - action [emoji=123456]</code>\n"
"\n"
"Styles: <code>success</code>, <code>primary</code>, <code>danger</code>.\n"
"\n"
"Start a new row on a new line.\n"
"\n"
"If you don't need a keyboard, tap “Skip”."

msgid "ADMIN_BROADCAST_NO_CONTENT"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> Failed to get the broadcast content. Please start over."

msgid "ADMIN_BROADCAST_PREVIEW"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> This is how the broadcast will look. Recipients: <b>{count}</b>.\n"
