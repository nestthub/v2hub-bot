msgid "PROVIDER_NOT_FOUND"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> 未找到服务商 <code>{provider_name}</code>。"

msgid "PROVIDER_CONNECTION_REQUEST"
msgstr ""
"<tg-emoji emoji-id=\"6005570495603282482\">🏷</tg-emoji> <b>服务商连接请求</b>\n"
"\n"
"<b>{provider_name}</b>\n"
"URL：{provider_url}\n"
"\n"
"该服务商请求获得添加订阅的权限。\n"
"\n"
"<tg-emoji emoji-id=\"6030445631921721471\">✅</tg-emoji> 连接服务商<b>不会影响</b>您的个人订阅——新订阅将与现有订阅并存。\n"
"\n"
"<tg-emoji emoji-id=\"5881702736843511327\">🔒</tg-emoji> 请在下方确认或拒绝该请求。"

msgid "PROVIDER_CONNECTION_LINK_INVALID"
msgstr ""
"<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> 连接链接无效或已过期。请让服务商发送新的链接。\n"
