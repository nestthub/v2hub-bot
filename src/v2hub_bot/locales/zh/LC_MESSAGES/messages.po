msgstr "创建用户"

msgid "ADMIN_USERS_PROVIDERS_NOT_FOUND"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> 该用户没有服务商。"

msgid "ADMIN_USERS_PROMPT"
msgstr "<tg-emoji emoji-id=\"5886412370347036129\">👤</tg-emoji> 请发送要查找的用户的 Telegram ID。"

msgid "ADMIN_USERS_INVALID_ID"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> ID 必须是数字。请重试。"

msgid "ADMIN_USERS_NOT_FOUND"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> 未找到 ID 为 <code>{user_id}</code> 的用户。"

msgid "ADMIN_USERS_INFO"
msgstr ""
"<tg-emoji emoji-id=\"5886412370347036129\">👤</tg-emoji> 用户信息：\n"
"ID：<code>{user_id}</code>\n"
"令牌：<tg-spoiler><code>{api_token}</code></tg-spoiler>\n"
"服务商：<code>{provider_name}</code>\n"
"首次启动机器人日期：{created_at}\n"
"在机器人中被封禁：{is_banned}"

msgid "ADMIN_USERS_UNKNOWN"
msgstr "未知"

msgid "BTN_ADMIN_USER_DELETE"
msgstr "删除用户"

msgid "ADMIN_USERS_DELETE_CONFIRM"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">⚠️</tg-emoji> 删除用户 <code>{user_id}</code>？此操作不可撤销：其 v2hub 账户及所有相关数据都将被删除。"

msgid "ADMIN_USERS_DELETED"
msgstr "<tg-emoji emoji-id=\"6030445631921721471\">✅</tg-emoji> 用户 <code>{user_id}</code> 已删除。"

msgid "ADMIN_USERS_DELETE_ERROR"
msgstr ""
"<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> 删除用户失败：\n"
"<code>{error}</code>"

msgid "BTN_ADMIN_BROADCAST_MODE_COPY"
msgstr "原样转发"

msgid "BTN_ADMIN_BROADCAST_MODE_COMPOSE"
msgstr "编写消息"

msgid "ADMIN_BROADCAST_SELECT_MODE"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> 您想如何准备群发消息？\n"
"\n"
"<b>原样转发</b> — 发送完整的成品消息（文本、媒体、格式、按钮——如有），它将原封不动地复制给每位收件人。\n"
"\n"
"<b>编写消息</b> — 发送文本或媒体，然后单独添加按钮（链接或操作）。"

msgid "ADMIN_BROADCAST_PROMPT"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> 请发送要群发给用户的消息——它将原样复制给收件人，包括所有媒体和已附加的键盘。\n"
"\n"
"支持 Telegram HTML 标记。"

msgid "ADMIN_BROADCAST_CONTENT_PROMPT"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> 请发送用于群发的文本或媒体（可带或不带说明）。下一步您可以为其添加按钮。\n"
"\n"
"支持 Telegram HTML 标记。"

msgid "ADMIN_BROADCAST_KEYBOARD_BUILDER"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> <b>添加键盘</b>\n"
"\n"
"按钮格式：\n"
"<code>文字 - callback_data</code>\n"
"\n"
"同一行多个按钮：\n"
"<code>目录 - catalog | 帮助 - help</code>\n"
"\n"
"链接：\n"
"<code>网站 - https://example.com</code>\n"
"\n"
"附加参数：\n"
"<code>按钮 - action [style=primary]</code>\n"
"<code>按钮 - action [emoji=123456]</code>\n"
"\n"
"样式：<code>success</code>、<code>primary</code>、<code>danger</code>。\n"
"\n"
"新的一行请另起一行。\n"
"\n"
"如果不需要键盘，请点击“跳过”。"

msgid "ADMIN_BROADCAST_NO_CONTENT"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> 无法获取群发内容。请重新开始。"

msgid "ADMIN_BROADCAST_PREVIEW"
msgstr ""
"<tg-emoji emoji-id=\"5771868281212245617\">📢</tg-emoji> 群发消息将如此显示。收件人：<b>{count}</b>。\n"
"\n"
"确认发送？"

msgid "ADMIN_BROADCAST_CANCELLED"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">❌</tg-emoji> 群发已取消。"

msgid "ADMIN_BROADCAST_STARTED"
msgstr "<tg-emoji emoji-id=\"5891211339170326418\">⏳</tg-emoji> 群发已开始。收件人：<b>{count}</b>。"

msgid "ADMIN_BROADCAST_PROGRESS"
msgstr "<tg-emoji emoji-id=\"5891211339170326418\">⏳</tg-emoji> 群发进行中：{sent}/{total}"

msgid "ADMIN_BROADCAST_DONE"
msgstr ""
"<tg-emoji emoji-id=\"6030445631921721471\">✅</tg-emoji> 群发已完成。\n"
