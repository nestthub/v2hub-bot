msgstr "неизвестно"

msgid "BTN_ADMIN_USER_DELETE"
msgstr "Удалить пользователя"

msgid "ADMIN_USERS_DELETE_CONFIRM"
msgstr "<tg-emoji emoji-id=\"6032636795387121097\">⚠️</tg-emoji> Удалить пользователя <code>{user_id}</code>? Это действие необратимо: будет удалён его аккаунт v2hub и вся связанная с ним информация."

msgid "ADMIN_USERS_DELETED"
