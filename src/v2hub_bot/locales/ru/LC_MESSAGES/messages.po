msgid "ADMIN_STATS_GET_OPTIONAL_PERIOD"
msgstr ""
"<tg-emoji emoji-id=\"5850317551090800862\">⏱️</tg-emoji> Введите период в формате:\n"
"<code>YYYY-MM-DD : YYYY-MM-DD</code>\n"
"\n"
"Можно указать только начало или конец периода:\n"
"<code>YYYY-MM-DD :</code> — с указанной даты\n"
"<code>: YYYY-MM-DD</code> — до указанной даты"

msgid "ADMIN_STATS_PERIOD_INVALID"
msgstr ""
